<?xml version="1.0" encoding="UTF-8"?>
<!--
  Built with WiX Toolset v3 (candle.exe / light.exe -ext WixUtilExtension),
  preinstalled on the windows-latest GitHub Actions runner image, so no
  third-party build tool needs to be installed in CI.

  Variables supplied at candle.exe time (-d<Name>=<Value>):
    Version              MSI ProductVersion, numeric major.minor.build only
    BinaryPath            path to the built smtprelayd.exe (windows/amd64)
    ExampleConfigPath      path to configs/smtprelayd.example.toml

  Registers the Windows service by running "smtprelayd.exe install" /
  "uninstall" as deferred custom actions, rather than WiX's own
  ServiceInstall element: the SCM registration must match exactly what
  cmd/smtprelayd/service_windows.go configures (service name, the
  NT SERVICE\smtprelayd virtual account, recovery action), and keeping that
  in one place avoids the two drifting apart. The service is installed but
  never started automatically: it has no usable configuration until the
  operator edits smtprelayd.toml.

  The data directory ACL is set the same way, by "smtprelayd.exe
  secure-datadir", and for the same reason: config.CheckDataDirACL refuses to
  start the service unless the DACL matches, so the side that writes it and
  the side that verifies it are one piece of code. util:PermissionEx was used
  here before and left the directory inheriting from %ProgramData%, which
  carries BUILTIN\Users:(OI)(CI)(RX); it adds ACEs but does not set
  PROTECTED_DACL_SECURITY_INFORMATION, so no install ever passed the check.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="smtprelayd"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Tokajer"
           UpgradeCode="64270ec1-058e-489e-bd2d-284e42cb37af">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of smtprelayd is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SMTPRelayd" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAFOLDER" Name="SMTPRelayd" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServiceBinary" Guid="*" Win64="yes">
        <File Id="smtprelaydEXE" Source="$(var.BinaryPath)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DATAFOLDER">
      <Component Id="ExampleConfig" Guid="*" Win64="yes">
        <File Id="ExampleConfigFile" Name="smtprelayd.toml.example"
              Source="$(var.ExampleConfigPath)" KeyPath="yes" />
      </Component>

      <!-- Explicit GUID, not "*": the KeyPath of this component is the
           directory itself, for which WiX cannot derive a stable GUID.
           Never regenerate it, or an upgrade will create a second folder. -->
      <!-- No RemoveFolder: the directory holds the spool, and a spool can
           still hold undelivered mail plus the history database at uninstall
           time. Removing it would discard mail the relay accepted and
           acknowledged. The operator deletes it deliberately or not at all. -->
      <Component Id="DataFolder" Guid="31B78A8A-3A73-417F-A500-5E8FEBFD9416" Win64="yes">
        <CreateFolder />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="smtprelayd" Level="1">
      <ComponentRef Id="ServiceBinary" />
      <ComponentRef Id="ExampleConfig" />
      <ComponentRef Id="DataFolder" />
    </Feature>

    <CustomAction Id="InstallServiceCA" FileKey="smtprelaydEXE" ExeCommand="install"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="StopServiceCA" FileKey="smtprelaydEXE" ExeCommand="stop"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UninstallServiceCA" FileKey="smtprelaydEXE" ExeCommand="uninstall"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SecureDataDirCA" FileKey="smtprelaydEXE" ExeCommand="secure-datadir"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <!-- Only on a genuinely fresh install: never on repair (Installed is
           already set) and never when upgrading an earlier version, so an
           in-place version bump does not re-register a service the SCM
           already holds. UPGRADINGPRODUCTCODE is not usable here: the engine
           only sets it in the nested RemoveExistingProducts call that
           removes the *old* product, never in this (the new product's) own
           execute sequence, so "NOT UPGRADINGPRODUCTCODE" was always true
           here and this action ran on every upgrade too, which is exactly
           what broke the 2026-08-18 upgrade, since the old registration is
           deliberately left in place by UninstallServiceCA below and
           "install" over an existing registration fails.
           WIX_UPGRADE_DETECTED is the property MajorUpgrade's FindRelatedProducts
           sets (and propagates as a secure property) in this product's own
           sequence when an earlier version is present. -->
      <Custom Action="InstallServiceCA" After="InstallFiles">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Custom>
      <!-- After InstallServiceCA, because the ACE for the NT SERVICE\smtprelayd
           virtual account can only be resolved once the service exists. Runs on
           repair and upgrade as well: an ACL widened by hand between versions
           is exactly the case that must be repaired. -->
      <Custom Action="SecureDataDirCA" After="InstallServiceCA">NOT REMOVE="ALL"</Custom>
      <!-- Runs on a plain uninstall AND on the old side of a major upgrade:
           the running service locks smtprelayd.exe, so it must be stopped
           before RemoveFiles or the subsequent InstallFiles of the new
           version fails to replace the binary. Only the registration
           removal below is skipped during an upgrade. -->
      <Custom Action="StopServiceCA" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="UninstallServiceCA" After="StopServiceCA">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
