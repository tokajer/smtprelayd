[Unit]
Description=SMTP relay for internal devices
Documentation=https://github.com/tokajer/smtprelayd
After=network-online.target
Wants=network-online.target

# A misconfigured bind address never heals by itself. Without these the
# default limit (5 starts / 10s) can never trip at RestartSec=5, and the
# cause is buried under an unbounded restart loop instead of surfacing
# as a failed unit.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Type=exec, not Type=notify: the binary does not send sd_notify(READY=1) yet.
Type=exec
# The rotated file under service.data_dir is the authoritative log; append
# -console here to mirror every line into journald as well. Deliberately not
# the default: journald rate limits (RateLimitBurst, 1000 messages per 30 s by
# default) and drops what exceeds it, so under a mail burst the copy an
# operator is most likely to read would be the incomplete one. Startup
# failures reach journald regardless — they happen on stderr before the file
# logger exists.
ExecStart=/usr/sbin/smtprelayd -config /etc/smtprelayd/smtprelayd.toml run
User=smtprelayd
Group=smtprelayd
Restart=on-failure
RestartSec=5

# Binds port 25/465/587 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. ReadWritePaths is the only writable location outside of it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/smtprelayd
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
